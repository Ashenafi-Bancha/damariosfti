# Copy to .env.local and fill in. Never commit .env.local.

# Public origin of the deployed site (used for canonical URLs, sitemap, JSON-LD)
NEXT_PUBLIC_SITE_URL=https://example.vercel.app

# Resend — transactional email for application notifications
# RESEND_FROM must be a sender on a domain verified in Resend
RESEND_API_KEY=
RESEND_FROM="Damarios FTI <noreply@example.com>"
# Where application notifications are delivered (institute inbox — TODO: client to confirm)
APPLY_TO_EMAIL=

# Telegram Bot API — the notification channel the staff actually read
# Create a bot via @BotFather, add it to the institute's chat, put the chat id here
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
